      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum(kube_node_status_condition{cluster_name=~\"$cluster\", condition=\"Ready\", status=\"false\"})",
          "legendFormat": "Down Nodes",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Nodes Down",
      "type": "stat"
