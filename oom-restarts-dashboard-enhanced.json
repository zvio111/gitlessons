        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value": 1
            },
            "renameByName": {
              "Value": "Down Duration (hrs)"
            }
          }
        }
      ],
      "type": "table"
    },
