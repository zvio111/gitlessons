      "id": 4,
      "options": {
        "footer": {
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Down Duration (hrs)"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "(
  max by (node) (
    kube_node_status_condition{
      cluster_name=~\"$cluster\",
      condition=\"Ready\",
      status=\"true\"
    }
  ) == bool 0
)
*
(
  time()
  -
  max by (node) (
    last_over_time(
      timestamp(
        kube_node_status_condition{
          cluster_name=~\"$cluster\",
          condition=\"Ready\",
          status=\"true\"
        } == 1
      )[30d:1m]
    )
  )
)
/ 3600",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
