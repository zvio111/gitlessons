            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "count(kube_node_status_condition{cluster_name=~\"$cluster\", condition=\"Ready\", status=\"true\"} == 1) / count(kube_node_status_condition{cluster_name=~\"$cluster\", condition=\"Ready\"}) * 100",
          "legendFormat": "Ready %",
          "range": true,
          "refId": "A"
        }
      ],
